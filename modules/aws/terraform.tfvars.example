expected_management_account_id = "123456789012"
name_prefix                   = "cloud-cost-connector"
artifact_version              = "1.0.0"
jfrog_artifactory_url         = "https://company.jfrog.io/artifactory"
jfrog_repository              = "mit-cloud-cost-agent"

victoriametrics_import_url       = "https://vendor-placeholder.metrics.manifestit.io/customer-path/api/v1/import/prometheus"
victoriametrics_token_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:cloud-cost-victoriametrics-token-EXAMPLE"

# Set only when the existing secret uses a customer-managed KMS key.
# victoriametrics_secret_kms_key_arn = "arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000"

timezone               = "UTC"
evaluation_lag_days    = 2
anomaly_threshold_pct  = 10
min_absolute_delta_usd = 1
min_baseline_usd       = 0.5

schedule_expression = "cron(0 10 * * ? *)"
schedule_timezone   = "UTC"
log_retention_days  = 30

account_allowlist = []
account_denylist  = []

tags = {
  Application = "cloud-cost-connector"
  ManagedBy   = "Terraform"
}
