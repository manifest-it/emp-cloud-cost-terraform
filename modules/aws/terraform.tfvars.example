expected_management_account_id = "123456789012"
artifact_version              = "0.6.0"
jfrog_artifactory_url         = "https://company.jfrog.io/artifactory"
jfrog_repository              = "mit-cloud-cost-agent"

empirik_api_url = "https://dev.api.manifestit.tech/client/cost"
org_key         = "customer-org-key"
mit_api_key     = "<API_KEY_PLACEHOLDER>"
cost_source_id  = 42

timezone               = "UTC"
evaluation_lag_days    = 2
anomaly_threshold_pct  = 10
min_absolute_delta_usd = 1
min_baseline_usd       = 0.5

schedule_expression = "cron(0 10 * * ? *)"
schedule_timezone   = "UTC"
log_retention_days  = 30

account_allowlist = []
account_denylist  = []

# One-time historical backfill via a separate EventBridge schedule.
backfill_enabled = false
# backfill_schedule_at = "2026-11-02T03:00:00" # future time in schedule_timezone
# backfill_days        = 15
# backfill_start_date  = "2026-01-01" # optional explicit range; overrides backfill_days
# backfill_end_date    = "2026-06-30"

tags = {
  Application = "cloud-cost-connector"
  ManagedBy   = "Terraform"
}
